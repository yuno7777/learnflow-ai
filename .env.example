# Copy to .env and fill in. Nothing here is a real credential.
#   cp .env.example .env && docker compose up --build

# ---------------------------------------------------------------- core
ENVIRONMENT=development
DEBUG=false

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-32-byte-hex-string
WEBHOOK_SIGNING_SECRET=change-me-generate-another-32-byte-hex-string
N8N_ENCRYPTION_KEY=change-me-generate-a-third-32-byte-hex-string

# ---------------------------------------------------------------- datastores
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow
POSTGRES_DB=learnflow
POSTGRES_PORT=5432
REDIS_PORT=6379
CHROMA_PORT=8001

# ---------------------------------------------------------------- ports
API_PORT=8000
WEB_PORT=3000
N8N_PORT=5678
OLLAMA_PORT=11434

# ---------------------------------------------------------------- AI providers
# mock = fully offline, deterministic, no API key needed. Start here.
# Alternatives: openai | azure_openai | huggingface | ollama
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# Used automatically when the primary provider fails after its retries.
LLM_FALLBACK_PROVIDER=
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
HUGGINGFACE_BASE_URL=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------- retrieval
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.25
MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------- automation
PUBLIC_API_BASE_URL=http://api:8000
N8N_BASE_URL=http://n8n:5678
# Create in the n8n UI (Settings > API) to let LearnFlow read execution details back.
N8N_API_KEY=
# Create in the LearnFlow UI (Settings > API keys) so n8n can call back into the API.
LEARNFLOW_API_KEY=
LEARNFLOW_ADMIN_EMAIL=admin@learnflow.dev
LEARNFLOW_INACTIVITY_DAYS=14

# ---------------------------------------------------------------- email
# Leave SMTP_HOST empty to use the mock adapter (messages are logged, never sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@learnflow.local

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------- ops
RATE_LIMIT_PER_MINUTE=120
TZ=UTC
